  <script is:inline>
    // 定义安全的强制初始化函数
    function initHeroSwiper() {
      // 检查当前环境是否已经加载成功全局 Swiper 引擎
      if (typeof Swiper !== 'undefined') {
        new Swiper('.hero-swiper', {
          loop: true,                 // 开启循环首尾相连播放
          autoplay: {
            delay: 4000,              // 每隔 4000 毫秒（4秒）切换一帧
            disableOnInteraction: false, // 就算客户用鼠标点了圆点，也不中断自动轮播机制
          },
          pagination: {
            el: '.swiper-pagination', // 绑定指示圆点的大容器
            clickable: true,          // 允许客户点击圆点自由切图
          },
          effect: 'fade',             // 改用电影级“淡入淡出”切图特效
          fadeEffect: {
            crossFade: true           // 开启交叉重叠淡出，告别切图时出现的黑边或白闪
          },
          speed: 800                  // 淡入淡出的切图过渡动画时间为 800 毫秒
        });
      }
    }

    // 保险一：当整个 DOM 树完成加载时强制调用一次
    document.addEventListener('DOMContentLoaded', initHeroSwiper);
    
    // 保险二：如果此时浏览器状态已经是就绪状态，直接无需等待立刻激活
    if (document.readyState === 'interactive' || document.readyState === 'complete') {
      initHeroSwiper();
    }
  </script>
</Base>