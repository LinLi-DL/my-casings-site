---
import Base from "@/layouts/Base.astro";
---

<Base title="Plastic Casing Category - HAITU CASING">

  <section class="relative w-full h-[65vh] md:h-[550px] bg-slate-900 overflow-hidden">
    <img 
      src="/images/plastic-casing-banner.png" 
      alt="Plastic Casing Banner" 
      class="absolute inset-0 w-full h-full object-fill opacity-60"
    />
    <div class="absolute inset-0 flex flex-col justify-center items-center text-center px-4">
      <h1 class="text-4xl md:text-6xl font-black tracking-wide text-orange-500 drop-shadow-[0_4px_12px_rgba(0,0,0,0.8)] uppercase my-0">
        Plastic Casing
      </h1>
      <p class="text-2xl md:text-3xl font-bold mt-4 tracking-wide text-white drop-shadow-[0_4px_8px_rgba(0,0,0,0.8)] uppercase my-0">
        High Barrier & Premium Solutions
      </p>
    </div>
  </section>

  <div class="w-full bg-[#1e293b] text-slate-400 py-3 border-b border-slate-800/60">
    <div class="container mx-auto px-4 flex justify-between items-center">
      <div class="text-white uppercase font-black tracking-wider text-base md:text-lg">
        <span class="text-orange-500">Plastic Casing Category</span>
      </div>
      <div class="text-[11px]">
        <a href="/collagen-casing" class="text-slate-300 hover:text-orange-500 no-underline font-semibold flex items-center gap-1">
          Switch to Collagen Casing &rarr;
        </a>
      </div>
    </div>
  </div>

  <div class="w-full bg-white pt-12 pb-2">
    <div class="max-w-5xl mx-auto px-4">
      <div class="bg-slate-50 border border-slate-100 rounded-xl p-4 flex flex-wrap items-center justify-between gap-3 shadow-sm">
        <div class="text-[11px] font-bold text-slate-400 tracking-wider uppercase pl-2">
          🎯 Quick Directory:
        </div>
        <div class="flex flex-wrap gap-2 text-xs">
          <a href="#high-barrier" class="px-3 py-1.5 bg-white border border-slate-200 rounded-lg font-bold text-slate-600 hover:border-orange-500 hover:text-orange-500 transition no-underline shadow-sm">1. High Barrier Film ↓</a>
          <a href="#standard-barrier" class="px-3 py-1.5 bg-white border border-slate-200 rounded-lg font-bold text-slate-600 hover:border-orange-500 hover:text-orange-500 transition no-underline shadow-sm">2. Standard Barrier ↓</a>
          <a href="#vacuum-pouches" class="px-3 py-1.5 bg-white border border-slate-200 rounded-lg font-bold text-slate-600 hover:border-orange-500 hover:text-orange-500 transition no-underline shadow-sm">3. Vacuum Pouches ↓</a>
          <a href="#big-caliber" class="px-3 py-1.5 bg-white border border-slate-200 rounded-lg font-bold text-slate-600 hover:border-orange-500 hover:text-orange-500 transition no-underline shadow-sm">4. Big Caliber Casing ↓</a>
        </div>
      </div>
    </div>
  </div>

  <section class="pt-6 pb-24 bg-white">
    <div class="container mx-auto px-4 text-center">
      
      <div class="max-w-5xl mx-auto bg-slate-50 border border-slate-100 rounded-2xl p-6 space-y-6 shadow-sm">
        
        <div id="high-barrier" class="scroll-mt-24 bg-white rounded-xl border border-slate-200/60 overflow-hidden grid grid-cols-1 md:grid-cols-2 shadow-sm text-left">
          <div class="p-8 md:p-10 flex flex-col justify-between space-y-4">
            <div>
              <h3 class="text-2xl font-bold text-slate-800 mb-4 relative pb-2 after:absolute after:bottom-0 after:left-0 after:w-12 after:h-[2px] after:bg-orange-500 mt-0">
                High Barrier Vacuum Bagging Film
              </h3>
              <p class="text-xs text-slate-500 leading-relaxed text-justify m-0">
                Most food products require modified atmosphere or vacuum packaging, such as fresh meats, processed meats, cheeses, seafood and other perishable products.
              </p>
            </div>

            <div class="bg-slate-50 p-3.5 border border-slate-100 rounded-lg space-y-2 text-xs text-slate-600 font-medium">
              <div>• <strong>3 PA layers</strong> and PA surface layer, perfect puncture resistance.</div>
              <div>• <strong>EVOH layer</strong> barrier, oxygen transmission &lt; 1 cm³/m².d.bar.</div>
              <div>• <strong>PE direct contact food layer</strong>, very healthy and safe.</div>
              <div>• <strong>MLLDPE sealing layer</strong> with excellent sealing performance.</div>
            </div>

            <div class="border border-slate-150 rounded-lg text-[11px] overflow-hidden bg-slate-50/50">
              <div class="p-2 border-b border-slate-100 flex">
                <div class="w-16 font-bold text-slate-400">Price:</div>
                <div class="text-amber-600 font-bold">Contact us for the latest prices</div>
              </div>
              <div class="p-2 flex items-start">
                <div class="w-16 font-bold text-slate-400">Service:</div>
                <div class="text-slate-500">Free Samples • 7*24h Support • 4h Clear Design</div>
              </div>
            </div>
          </div>
          <div class="bg-slate-100/30 p-6 flex flex-col justify-center items-center gap-4 border-l border-slate-100/80">
            <div class="w-full max-w-[260px] bg-white border border-slate-200 p-2 rounded shadow-sm">
              <img src="/images/products/high-barrier.jpg" alt="High Barrier Vacuum Bagging Film" class="w-full h-auto object-contain block" />
            </div>
            <div class="w-full max-w-[220px] bg-white border border-slate-200 p-2 rounded shadow-sm">
              <div class="text-[9px] font-black text-slate-400 mb-1 tracking-widest text-center uppercase">STRUCTURE LAYOUT</div>
              <img src="/images/products/high-barrier-structure.png" alt="Multi-layer Structure" class="w-full h-auto block" />
            </div>
          </div>
        </div>

        <div id="standard-barrier" class="scroll-mt-24 bg-white rounded-xl border border-slate-200/60 overflow-hidden grid grid-cols-1 md:grid-cols-2 shadow-sm text-left">
          <div class="bg-slate-100/30 p-6 flex items-center justify-center border-r border-slate-100/80 md:order-first order-last">
            <div class="w-full max-w-[260px] bg-white border border-slate-200 p-2 rounded shadow-sm">
              <img src="/images/products/standard-barrier.jpg" alt="Standard Barrier Vacuum Bagging Film" class="w-full h-auto object-contain block" />
            </div>
          </div>
          <div class="p-8 md:p-10 flex flex-col justify-between space-y-4">
            <div>
              <h3 class="text-2xl font-bold text-slate-800 mb-4 relative pb-2 after:absolute after:bottom-0 after:left-0 after:w-12 after:h-[2px] after:bg-orange-500 mt-0">
                Standard Barrier Vacuum Bagging Film
              </h3>
              <p class="text-xs text-slate-500 leading-relaxed text-justify m-0">
                Reliable protection for daily meat products and standard vacuum sealing requirements, ensuring optimal shelf life, excellent clarity and freshness.
              </p>
            </div>
            <div class="border border-slate-150 rounded-lg text-[11px] overflow-hidden bg-slate-50/50">
              <div class="p-2 border-b border-slate-100 flex">
                <div class="w-16 font-bold text-slate-400">Price:</div>
                <div class="text-amber-600 font-bold">Contact us for the latest prices</div>
              </div>
              <div class="p-2 flex items-start">
                <div class="w-16 font-bold text-slate-400">Service:</div>
                <div class="text-slate-500">Free Samples • 7*24h Support • Quick Design Reply</div>
              </div>
            </div>
          </div>
        </div>

        <div id="vacuum-pouches" class="scroll-mt-24 bg-white rounded-xl border border-slate-200/60 overflow-hidden grid grid-cols-1 md:grid-cols-2 shadow-sm text-left">
          <div class="p-8 md:p-10 flex flex-col justify-center space-y-4">
            <h3 class="text-2xl font-bold text-slate-800 mb-4 relative pb-2 after:absolute after:bottom-0 after:left-0 after:w-12 after:h-[2px] after:bg-orange-500 mt-0">
              Vacuum Pouches (Bags)
            </h3>
            <p class="text-xs text-slate-500 leading-relaxed text-justify m-0">
              Pre-made high-strength vacuum bags suitable for various food processing lines. Offers excellent sealing stability, high puncture resistance, and transparent product presentation.
            </p>
          </div>
          <div class="bg-slate-100/30 p-6 flex items-center justify-center border-l border-slate-100/80">
            <div class="w-full max-w-[260px] bg-white border border-slate-200 p-2 rounded shadow-sm">
              <img src="/images/products/vacuum-pouches.jpg" alt="Vacuum Pouches" class="w-full h-auto object-contain block" />
            </div>
          </div>
        </div>

        <div id="big-caliber" class="scroll-mt-24 bg-white rounded-xl border border-slate-200/60 overflow-hidden grid grid-cols-1 md:grid-cols-2 shadow-sm text-left">
          <div class="bg-slate-100/30 p-6 flex items-center justify-center border-r border-slate-100/80 md:order-first order-last">
            <div class="w-full max-w-[260px] bg-white border border-slate-200 p-2 rounded shadow-sm">
              <img src="/images/products/big-caliber.jpg" alt="Big Caliber Plastic Shrunk Casing" class="w-full h-auto object-contain block" />
            </div>
          </div>
          <div class="p-8 md:p-10 flex flex-col justify-center space-y-4">
            <h3 class="text-2xl font-bold text-slate-800 mb-4 relative pb-2 after:absolute after:bottom-0 after:left-0 after:w-12 after:h-[2px] after:bg-orange-500 mt-0">
              Big Caliber Plastic Shrunk Casing
            </h3>
            <p class="text-xs text-slate-500 leading-relaxed text-justify m-0">
              Specially designed for large-diameter sausage processing, offering high mechanical strength, uniform shrinkage, and excellent caliber control during high-speed filling.
            </p>
          </div>
        </div>

      </div>
      
    </div>
  </section>

</Base>