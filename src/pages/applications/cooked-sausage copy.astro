---
// src/pages/applications/cooked-sausage.astro
import Base from "@/layouts/Base.astro";
---

<Base title="Cooked Sausage Casing Solutions | HAITU CASING">
  <section class="bg-slate-900 text-white py-16 md:py-24 border-b border-slate-800">
    <div class="container mx-auto px-4 max-w-7xl">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        
        <div class="space-y-6">
          <div class="flex items-center gap-2">
            <a href="/" class="text-orange-500 hover:text-orange-400 text-xs uppercase tracking-widest no-underline font-bold">Home</a>
            <span class="text-slate-600 text-xs">/</span>
            <span class="text-slate-400 text-xs uppercase tracking-widest font-medium">Applications</span>
          </div>
          <h1 class="text-3xl md:text-5xl font-black uppercase tracking-tight text-white leading-tight m-0">
            Cooked Sausage <br />
            <span class="text-orange-500">Casing Solutions</span>
          </h1>
          <p class="text-slate-300 text-sm md:text-base leading-relaxed max-w-xl m-0 font-medium">
            High-Barrier Polyamide (PA) Casings explicitly engineered for extended shelf life, extreme thermal stability, and zero weight loss during cooking processing worldwide.
          </p>
          <div class="pt-2">
            <a href="#sample-form" class="inline-block py-3.5 px-8 bg-orange-500 hover:bg-orange-600 text-white font-bold text-xs uppercase tracking-widest rounded transition-all no-underline shadow-md">
              Request Evaluation Samples
            </a>
          </div>
        </div>
        
        <div class="relative rounded-2xl overflow-hidden border border-slate-800 shadow-2xl aspect-[4/3] bg-slate-950 flex items-center justify-center group">
          <img src="/images/app/cooked-sausage.jpg" alt="Cooked Sausage Casing" class="w-full h-full object-cover opacity-80" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/40 via-transparent to-transparent"></div>
        </div>

      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="container mx-auto px-4 max-w-7xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
        
        <div class="lg:col-span-7 space-y-8">
          <div>
            <span class="text-xs font-bold text-orange-500 tracking-widest uppercase font-mono">Targeted Efficiency</span>
            <h2 class="text-2xl md:text-3xl font-black text-slate-900 uppercase tracking-tight mt-1 mb-0">Operational Benefits</h2>
            <div class="w-12 h-1 bg-orange-500 mt-4 rounded-full"></div>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="p-5 bg-slate-50 border border-slate-100 rounded-xl space-y-2">
              <div class="text-orange-500 font-bold text-lg">✓ Zero Weight Loss</div>
              <p class="text-xs text-slate-500 leading-relaxed font-medium m-0">Multi-layer PA co-extrusion structure prevents moisture evaporation during smoking and boiling, ensuring maximum product yield.</p>
            </div>
            <div class="p-5 bg-slate-50 border border-slate-100 rounded-xl space-y-2">
              <div class="text-orange-500 font-bold text-lg">✓ Caliber Consistency</div>
              <p class="text-xs text-slate-500 leading-relaxed font-medium m-0">Strictly calibrated nominal diameter parameters secure perfect structural uniformity across automatic high-speed clipping lines.</p>
            </div>
            <div class="p-5 bg-slate-50 border border-slate-100 rounded-xl space-y-2">
              <div class="text-orange-500 font-bold text-lg">✓ Extended Shelf-Life</div>
              <p class="text-xs text-slate-500 leading-relaxed font-medium m-0">Outstanding oxygen barriers eliminate oxidative rancidity, preserving full taste profiles for traditional recipes like Doctorskaya.</p>
            </div>
            <div class="p-5 bg-slate-50 border border-slate-100 rounded-xl space-y-2">
              <div class="text-orange-500 font-bold text-lg">✓ High Mechanical Tensile</div>
              <p class="text-xs text-slate-500 leading-relaxed font-medium m-0">Withstands high stuffing and clipping pressures without premature skin rupture or line downtime bursts.</p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 bg-slate-50 border border-slate-200/80 p-6 md:p-8 rounded-2xl shadow-sm h-fit">
          <h3 class="text-sm font-black text-slate-900 uppercase tracking-widest mb-6 m-0 border-b border-slate-200 pb-3 flex items-center justify-between">
            <span>Technical Datasheet</span>
            <span class="text-[10px] font-mono text-slate-400 font-normal">Grade A-1</span>
          </h3>
          <table class="w-full text-left border-collapse">
            <tbody class="text-xs text-slate-700 font-medium">
              <tr class="border-b border-slate-200/60">
                <td class="py-3 pr-4 font-bold text-slate-900 w-[40%] align-top">Material Base</td>
                <td class="py-3 text-slate-600 align-top">Polyamide (PA/PE Multi-layer Co-extrusion)</td>
              </tr>
              <tr class="border-b border-slate-200/60">
                <td class="py-3 pr-4 font-bold text-slate-900 align-top">Available Calibers</td>
                <td class="py-3 text-slate-600 align-top">40mm - 200mm (Nominal Filling Diameter)</td>
              </tr>
              <tr class="border-b border-slate-200/60">
                <td class="py-3 pr-4 font-bold text-slate-900 align-top">Supply Forms</td>
                <td class="py-3 text-slate-600 align-top">Shirred sticks, Lay-flat rolls / reels, Cut pieces</td>
              </tr>
              <tr class="border-b border-slate-200/60">
                <td class="py-3 pr-4 font-bold text-slate-900 align-top">Printing Options</td>
                <td class="py-3 text-slate-600 align-top">Up to 8 Colors high-resolution double-sided printing</td>
              </tr>
              <tr class="border-b border-slate-200/60">
                <td class="py-3 pr-4 font-bold text-slate-900 align-top">Thermal Fit</td>
                <td class="py-3 text-slate-600 align-top">Max cooking temperature up to 121°C (Sterilization Grade)</td>
              </tr>
              <tr>
                <td class="py-3 pr-4 font-bold text-slate-900 align-top">Machinery Fit</td>
                <td class="py-3 text-slate-600 align-top">Poly-clip, Alpina, Tippertie automated clipping lines</td>
              </tr>
            </tbody>
          </table>
        </div>

      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-950 text-white scroll-mt-12" id="sample-form">
    <div class="container mx-auto px-4 max-w-3xl text-center space-y-4">
      <span class="text-xs font-bold text-orange-400 tracking-widest uppercase font-mono">Global Sourcing Program</span>
      <h2 class="text-2xl md:text-4xl font-black text-white uppercase tracking-tight m-0">Request Evaluation Samples</h2>
      <p class="text-xs md:text-sm text-slate-400 max-w-xl mx-auto leading-relaxed m-0 font-medium">
        Our evaluation sample packages are pre-cleared for smooth regulatory customs checkpoints. Specially configured to match your factory's technical filler testing.
      </p>
      
      <div class="bg-slate-900 p-6 md:p-10 rounded-2xl border border-slate-800 text-left shadow-xl !mt-10">
        <form class="space-y-4">
          <input type="hidden" name="target_application" value="Cooked Sausage" />
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-[10px] font-mono text-slate-400 uppercase tracking-wider mb-1.5">Contact Name</label>
              <input type="text" class="w-full bg-slate-950 border border-slate-800 rounded px-4 py-2.5 text-xs text-white focus:border-orange-500 outline-none transition-colors" required />
            </div>
            <div>
              <label class="block text-[10px] font-mono text-slate-400 uppercase tracking-wider mb-1.5">Business Email</label>
              <input type="email" class="w-full bg-slate-950 border border-slate-800 rounded px-4 py-2.5 text-xs text-white focus:border-orange-500 outline-none transition-colors" required />
            </div>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-[10px] font-mono text-slate-400 uppercase tracking-wider mb-1.5">Target Caliber (e.g., 60mm)</label>
              <input type="text" class="w-full bg-slate-950 border border-slate-800 rounded px-4 py-2.5 text-xs text-white focus:border-orange-500 outline-none transition-colors" placeholder="Required width or size" />
            </div>
            <div>
              <label class="block text-[10px] font-mono text-slate-400 uppercase tracking-wider mb-1.5">Stuffing Equipment Brand</label>
              <input type="text" class="w-full bg-slate-950 border border-slate-800 rounded px-4 py-2.5 text-xs text-white focus:border-orange-500 outline-none transition-colors" placeholder="e.g., Poly-clip / Alpina" />
            </div>
          </div>
          
          <div>
            <label class="block text-[10px] font-mono text-slate-400 uppercase tracking-wider mb-1.5">Message / Technical Requirements</label>
            <textarea rows="4" class="w-full bg-slate-950 border border-slate-800 rounded px-4 py-2.5 text-xs text-white focus:border-orange-500 outline-none transition-colors resize-none" placeholder="Tell us more about your meat processing recipe parameters..."></textarea>
          </div>
          
          <button type="submit" class="w-full py-3.5 bg-orange-500 hover:bg-orange-600 text-white font-bold text-xs uppercase tracking-widest rounded transition-all shadow-md !mt-6">
            Submit Sample Request
          </button>
        </form>
      </div>
    </div>
  </section>
</Base>