---
// =========================================================================
// 顶层数据配置区 (Astro Frontmatter)
// 这里用于引入全局组件、进行页面级别的初始化配置
// =========================================================================
import Base from "@/layouts/Base.astro";
---

<Base title="HAITU CASING | Premium Sausage Casing Solutions">

  <!-- ==========================================
       1. HERO 顶部的极细灰色小条 (F非常细的小条)
       ========================================== -->
  <div class="w-full bg-[#1e293b] text-slate-400 py-1 text-[11px] border-b border-slate-800/60">
    <div class="container mx-auto px-4 flex justify-between items-center">
      <div>Welcome to our company</div>
      <div class="flex items-center gap-4">
        <span class="flex items-center gap-1">✉️ sales@haitucasing.com</span>
        <span class="flex items-center gap-1">📞 +86-15092056506</span>
      </div>
    </div>
  </div>


<!-- ==========================================
       2. HERO SWIPER 轮播大图 (终极高清 1:1 纯净全屏版)
       ========================================== -->

  <section class="relative w-full h-[85vh] md:h-[calc(100vh-96px)] bg-slate-900 overflow-hidden">
    <div class="swiper hero-swiper h-full w-full">
      <div class="swiper-wrapper">

        <div class="swiper-slide relative h-full w-full bg-slate-950">
          <img src="/images/hero/factory_line.png" alt="Sausage Casing Solutions" class="absolute inset-0 w-full h-full object-cover opacity-40 mix-blend-luminosity" />
          <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/70 to-transparent"></div>
          <div class="container mx-auto px-6 h-full flex items-center relative z-10">
            <div class="max-w-3xl text-left space-y-4">
              <h1 class="text-2xl md:text-4xl font-black tracking-tight text-orange-500 uppercase my-0 whitespace-nowrap">
                Complete Sausage Casing Solutions
              </h1>
              <p class="text-sm md:text-base text-slate-300 font-medium leading-relaxed max-w-xl my-0">
                Plastic, Collagen & Tailor-Made Sourcing. Explicitly engineered for seamless performance across modern automated meat processing lines worldwide.
              </p>
              <div class="pt-2">
                <a href="#applications-section" class="inline-block py-3.5 px-8 bg-orange-500 hover:bg-orange-600 text-white font-bold text-xs uppercase tracking-widest rounded transition-all shadow-md no-underline">
                  Find Your Casing by Application
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="swiper-slide relative h-full w-full bg-slate-950">
          <img src="/images/hero/plastic_rolls.png" alt="High-Barrier Plastic Casings" class="absolute inset-0 w-full h-full object-cover opacity-35" />
          <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/70 to-transparent"></div>
          <div class="container mx-auto px-6 h-full flex items-center relative z-10">
            <div class="max-w-3xl text-left space-y-4">
              <h2 class="text-2xl md:text-4xl font-black tracking-tight text-orange-500 uppercase my-0 whitespace-nowrap">
                High-Barrier Plastic Casings
              </h2>
              <p class="text-sm md:text-base text-slate-300 font-medium leading-relaxed max-w-xl my-0">
                Multi-layer Polyamide (PA) co-extrusion configured to maximize your meat product's shelf-life and achieve zero weight loss during cooking.
              </p>
              <div class="pt-2">
                <a href="#products-section" class="inline-block py-3.5 px-8 bg-orange-500 hover:bg-orange-600 text-white font-bold text-xs uppercase tracking-widest rounded transition-all shadow-md no-underline">
                  Explore Plastic Specifications
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="swiper-slide relative h-full w-full bg-slate-950">
          <img src="/images/hero/collagen_sticks.png" alt="High-Speed Collagen Casings" class="absolute inset-0 w-full h-full object-cover opacity-35" />
          <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/70 to-transparent"></div>
          <div class="container mx-auto px-6 h-full flex items-center relative z-10">
            <div class="max-w-3xl text-left space-y-4">
              <h2 class="text-2xl md:text-4xl font-black tracking-tight text-orange-500 uppercase my-0 whitespace-nowrap">
                High-Speed Collagen Casings
              </h2>
              <p class="text-sm md:text-base text-slate-300 font-medium leading-relaxed max-w-xl my-0">
                Edible & non-edible premium animal protein structures optimized rigorously for mechanical twisting on high-speed linking lines.
              </p>
              <div class="pt-2">
                <a href="#products-section" class="inline-block py-3.5 px-8 bg-orange-500 hover:bg-orange-600 text-white font-bold text-xs uppercase tracking-widest rounded transition-all shadow-md no-underline">
                  Explore Collagen Range
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="swiper-slide relative h-full w-full bg-slate-950">
          <img src="/images/hero/special_solutions.png" alt="Customized Casing Solutions" class="absolute inset-0 w-full h-full object-cover opacity-30" />
          <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/70 to-transparent"></div>
          <div class="container mx-auto px-6 h-full flex items-center relative z-10">
            <div class="max-w-3xl text-left space-y-4">
              <h2 class="text-2xl md:text-4xl font-black tracking-tight text-orange-500 uppercase my-0 whitespace-nowrap">
                Customized & Special Sourcing
              </h2>
              <p class="text-sm md:text-base text-slate-300 font-medium leading-relaxed max-w-xl my-0">
                Tailor-made structural polymers and high-tensile cellulose integrations meticulously built to withstand automatic high-speed peeling systems.
              </p>
              <div class="pt-2">
                <a href="#contact" class="inline-block py-3.5 px-8 bg-orange-500 hover:bg-orange-600 text-white font-bold text-xs uppercase tracking-widest rounded transition-all shadow-md no-underline">
                  Request Custom Solution
                </a>
              </div>
            </div>
          </div>
        </div>

      </div>
      <div class="swiper-pagination !bottom-8"></div>
    </div>
  </section>





  <section class="py-20 bg-white scroll-mt-24" id="applications-section">
    <div class="container mx-auto px-4 text-center">
      
      <span class="text-xs font-bold text-orange-500 tracking-widest uppercase">Targeted Efficiency</span>
      <h2 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight mt-2 mb-4 uppercase">
        Find Your Casing by Application
      </h2>
      <p class="text-sm md:text-base text-slate-500 max-w-2xl mx-auto font-medium my-0">
        Select your specific end-product type. Our solutions are explicitly calibrated to match the thermal processing, transparency, and barrier demands of global meat recipes.
      </p>
      <div class="w-16 h-1 bg-orange-500 mx-auto mt-6 mb-16 rounded-full"></div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6 max-w-7xl mx-auto">
        
        <a href="/applications/cooked-sausage" class="group block cursor-pointer no-underline text-slate-900">
          <div class="relative overflow-hidden rounded-xl shadow-sm border border-slate-100 bg-slate-50 aspect-square">
            <img src="/images/app/cooked-sausage.jpg" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" alt="Cooked Sausage" />
            <div class="absolute inset-0 bg-slate-950/80 flex items-center justify-center p-4 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
              <p class="text-[11px] text-orange-400 font-bold leading-relaxed m-0">
                Recommended: High-Barrier Polyamide (PA) Casings for extended shelf life.
              </p>
            </div>
          </div>
          <h3 class="mt-4 font-bold text-sm tracking-wide group-hover:text-orange-500 transition-colors uppercase my-0">Cooked Sausage</h3>
        </a>

        <a href="/applications/ham" class="group block cursor-pointer no-underline text-slate-900">
          <div class="relative overflow-hidden rounded-xl shadow-sm border border-slate-100 bg-slate-50 aspect-square">
            <img src="/images/app/ham.jpg" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" alt="Ham" />
            <div class="absolute inset-0 bg-slate-950/80 flex items-center justify-center p-4 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
              <p class="text-[11px] text-orange-400 font-bold leading-relaxed m-0">
                Recommended: Caliber-Controlled Plastic Casings for high-precision slicing lines.
              </p>
            </div>
          </div>
          <h3 class="mt-4 font-bold text-sm tracking-wide group-hover:text-orange-500 transition-colors uppercase my-0">Ham & Slicing</h3>
        </a>

        <a href="/applications/bologna" class="group block cursor-pointer no-underline text-slate-900">
          <div class="relative overflow-hidden rounded-xl shadow-sm border border-slate-100 bg-slate-50 aspect-square">
            <img src="/images/app/bologna.jpg" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" alt="Bologna" />
            <div class="absolute inset-0 bg-slate-950/80 flex items-center justify-center p-4 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
              <p class="text-[11px] text-orange-400 font-bold leading-relaxed m-0">
                Recommended: Multi-layer Co-extruded Casings with excellent dimensional stability.
              </p>
            </div>
          </div>
          <h3 class="mt-4 font-bold text-sm tracking-wide group-hover:text-orange-500 transition-colors uppercase my-0">Bologna</h3>
        </a>

        <a href="/applications/frankfurter" class="group block cursor-pointer no-underline text-slate-900">
          <div class="relative overflow-hidden rounded-xl shadow-sm border border-slate-100 bg-slate-50 aspect-square">
            <img src="/images/app/frankfurter.jpg" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" alt="Frankfurter" />
            <div class="absolute inset-0 bg-slate-950/80 flex items-center justify-center p-4 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
              <p class="text-[11px] text-orange-400 font-bold leading-relaxed m-0">
                Recommended: Uniform-caliber Collagen & Cellulose solutions for fast peeling.
              </p>
            </div>
          </div>
          <h3 class="mt-4 font-bold text-sm tracking-wide group-hover:text-orange-500 transition-colors uppercase my-0">Frankfurter</h3>
        </a>

        <a href="/applications/hot-dog" class="group block cursor-pointer no-underline text-slate-900">
          <div class="relative overflow-hidden rounded-xl shadow-sm border border-slate-100 bg-slate-50 aspect-square">
            <img src="/images/app/hot-dog.jpg" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" alt="Hot Dog" />
            <div class="absolute inset-0 bg-slate-950/80 flex items-center justify-center p-4 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
              <p class="text-[11px] text-orange-400 font-bold leading-relaxed m-0">
                Recommended: Edible Collagen Casings optimized for high-speed automated linkers.
              </p>
            </div>
          </div>
          <h3 class="mt-4 font-bold text-sm tracking-wide group-hover:text-orange-500 transition-colors uppercase my-0">Hot Dog</h3>
        </a>

        <a href="/applications/smoked-sausage" class="group block cursor-pointer no-underline text-slate-900">
          <div class="relative overflow-hidden rounded-xl shadow-sm border border-slate-100 bg-slate-50 aspect-square">
            <img src="/images/app/smoked-sausage.webp" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" alt="Smoked Sausage" />
            <div class="absolute inset-0 bg-slate-950/80 flex items-center justify-center p-4 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
              <p class="text-[11px] text-orange-400 font-bold leading-relaxed m-0">
                Recommended: Highly permeable Smokable Plastic or Collagen Casings for rich flavor absorption.
              </p>
            </div>
          </div>
          <h3 class="mt-4 font-bold text-sm tracking-wide group-hover:text-orange-500 transition-colors uppercase my-0">Smoked Sausage</h3>
        </a>

      </div>
    </div>
  </section>

  <section class="py-24 bg-slate-50 scroll-mt-24 border-t border-b border-slate-100" id="products-section">
    <div class="container mx-auto px-4">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold text-orange-500 tracking-widest uppercase">Our Product Range</span>
        <h2 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight mt-2 mb-4 uppercase">
          Engineered For Modern Processing
        </h2>
        <p class="text-sm md:text-base text-slate-500 font-medium my-0">
          Discover our technical grade casing solutions, meticulously engineered to secure extreme thermal performance and exceptional line efficiencies.
        </p>
        <div class="w-16 h-1 bg-orange-500 mx-auto mt-6"></div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
        
        <div class="bg-white rounded-2xl shadow-md hover:shadow-xl border border-slate-100 overflow-hidden flex flex-col group transition-all duration-300">
          <div class="relative h-64 overflow-hidden bg-slate-900">
            <img src="/images/products/plastic_casings_spec.png" alt="Plastic Casings Specification" class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-500 opacity-90" />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 to-transparent"></div>
          </div>
          
          <div class="p-6 md:p-8 flex flex-col flex-grow">
            <h3 class="text-2xl font-black text-slate-900 tracking-tight uppercase mb-4 my-0">Plastic Casings</h3>
            
            <div class="flex flex-wrap gap-2 mb-6">
              <span class="px-2.5 py-1 bg-slate-100 border border-slate-200 text-slate-700 font-bold text-[10px] tracking-wide uppercase rounded">
                Multi-layer PA Co-extrusion
              </span>
              <span class="px-2.5 py-1 bg-orange-500/5 border border-orange-500/20 text-orange-600 font-bold text-[10px] tracking-wide uppercase rounded">
                High Barrier & Zero Weight Loss
              </span>
              <span class="px-2.5 py-1 bg-slate-100 border border-slate-200 text-slate-700 font-bold text-[10px] tracking-wide uppercase rounded">
                Up to 8 Colors Precision Printing
              </span>
            </div>
            
            <p class="text-sm text-slate-500 leading-relaxed font-medium mb-8 flex-grow my-0">
              Engineered from premium Polyamide (PA) polymers, our multi-layer plastic casings provide superior oxygen and moisture barrier protection. Perfect for high-speed automatic clipping, ensuring standard caliber consistency from first to last centimeter.
            </p>
            
            <a href="/products/plastic-casings" class="w-full block py-3.5 px-6 bg-slate-900 hover:bg-orange-500 text-white font-bold text-xs uppercase tracking-widest text-center rounded transition-colors no-underline shadow-sm">
              View Plastic Specs
            </a>
          </div>
        </div>

        <div class="bg-white rounded-2xl shadow-md hover:shadow-xl border border-slate-100 overflow-hidden flex flex-col group transition-all duration-300">
          <div class="relative h-64 overflow-hidden bg-slate-900">
            <img src="/images/products/collagen_casings_spec.png" alt="Collagen Casings Specification" class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-500 opacity-90" />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 to-transparent"></div>
          </div>
          
          <div class="p-6 md:p-8 flex flex-col flex-grow">
            <h3 class="text-2xl font-black text-slate-900 tracking-tight uppercase mb-4 my-0">Collagen Casings</h3>
            
            <div class="flex flex-wrap gap-2 mb-6">
              <span class="px-2.5 py-1 bg-slate-100 border border-slate-200 text-slate-700 font-bold text-[10px] tracking-wide uppercase rounded">
                Edible & Non-Edible Range
              </span>
              <span class="px-2.5 py-1 bg-orange-500/5 border border-orange-500/20 text-orange-600 font-bold text-[10px] tracking-wide uppercase rounded">
                Precise Caliber (13mm-50mm)
              </span>
              <span class="px-2.5 py-1 bg-slate-100 border border-slate-200 text-slate-700 font-bold text-[10px] tracking-wide uppercase rounded">
                Built for High-Speed Linking
              </span>
            </div>
            
            <p class="text-sm text-slate-500 leading-relaxed font-medium mb-8 flex-grow my-0">
              Manufactured from highly purified animal collagen protein. Our collagen casings deliver exceptional elasticity and mechanised strength, guaranteeing unbroken performance on high-speed twisting and linking lines like Handtmann or Vemag.
            </p>
            
            <a href="/products/collagen-casings" class="w-full block py-3.5 px-6 bg-slate-900 hover:bg-orange-500 text-white font-bold text-xs uppercase tracking-widest text-center rounded transition-colors no-underline shadow-sm">
              View Collagen Specs
            </a>
          </div>
        </div>

        <div class="bg-white rounded-2xl shadow-md hover:shadow-xl border border-slate-100 overflow-hidden flex flex-col group transition-all duration-300">
          <div class="relative h-64 overflow-hidden bg-slate-900">
            <img src="/images/products/custom_solutions_spec.jpg" alt="Customized Casing Solutions" class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-500 opacity-90" />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 to-transparent"></div>
          </div>
          
          <div class="p-6 md:p-8 flex flex-col flex-grow">
            <h3 class="text-2xl font-black text-slate-900 tracking-tight uppercase mb-4 my-0">Customized & Special Solutions</h3>
            
            <div class="flex flex-wrap gap-2 mb-6">
              <span class="px-2.5 py-1 bg-slate-100 border border-slate-200 text-slate-700 font-bold text-[10px] tracking-wide uppercase rounded">
                Tailor-Made Polymer Engineering
              </span>
              <span class="px-2.5 py-1 bg-orange-500/5 border border-orange-500/20 text-orange-600 font-bold text-[10px] tracking-wide uppercase rounded">
                Cellulose Sourcing Programs
              </span>
              <span class="px-2.5 py-1 bg-slate-100 border border-slate-200 text-slate-700 font-bold text-[10px] tracking-wide uppercase rounded">
                Automated High-Speed Peeling Fit
              </span>
            </div>
            
            <p class="text-sm text-slate-500 leading-relaxed font-medium mb-8 flex-grow my-0">
              We collaborate with premier global manufacturers to source and configure advanced cellulosics and custom polymer formulations. Engineered specifically to meet the high-tensile demands of high-speed automatic peeling and industrial processing lines.
            </p>
            
            <a href="/solutions/custom-sourcing" class="w-full block py-3.5 px-6 bg-orange-500 hover:bg-orange-600 text-white font-bold text-xs uppercase tracking-widest text-center rounded transition-colors no-underline shadow-sm">
              Request Custom Solution
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="py-24 bg-white border-b border-slate-100 scroll-mt-24" id="comparison-section">
    <div class="container mx-auto px-4">
      
      <div class="mb-12 text-left max-w-7xl mx-auto">
        <span class="text-xs font-bold text-slate-500 tracking-widest uppercase">Technical Data Sheet</span>
        <h2 class="text-3xl font-black text-slate-900 tracking-tight mt-1 uppercase">
          Quick Technical Selection Guide
        </h2>
        <div class="w-12 h-1 bg-slate-900 mt-4"></div>
      </div>

      <div class="w-full overflow-x-auto border border-slate-200 rounded-xl max-w-7xl mx-auto shadow-sm">
        <table class="w-full text-left border-collapse min-w-[800px]">
          <thead>
            <tr class="bg-slate-800 text-white font-bold text-xs tracking-wider uppercase border-none">
              <th class="py-4 px-6 w-[22%]">Technical Parameter</th>
              <th class="py-4 px-6 w-[26%]">Plastic Casings</th>
              <th class="py-4 px-6 w-[26%]">Collagen Casings</th>
              <th class="py-4 px-6 w-[26%]">Customized & Special (inc. Cellulose)</th>
            </tr>
          </thead>
          <tbody class="text-xs text-slate-700 font-medium">
            <tr class="border-b border-slate-100">
              <td class="py-4 px-6 bg-slate-50/70 font-bold text-slate-900">Supply Mode</td>
              <td class="py-4 px-6">Standard & Custom Stock</td>
              <td class="py-4 px-6">Standard & Custom Stock</td>
              <td class="py-4 px-6">On-Demand Sourcing & OEM</td>
            </tr>
            <tr class="border-b border-slate-100">
              <td class="py-4 px-6 bg-slate-50/70 font-bold text-slate-900">Material Base</td>
              <td class="py-4 px-6">Polyamide (PA/PE Multilayer)</td>
              <td class="py-4 px-6">Natural Collagen Protein</td>
              <td class="py-4 px-6">Refined Cellulose / Special Polymers</td>
            </tr>
            <tr class="border-b border-slate-100">
              <td class="py-4 px-6 bg-slate-50/70 font-bold text-slate-900">Edible Properties</td>
              <td class="py-4 px-6">No (Non-edible)</td>
              <td class="py-4 px-6">Yes (Edible series available)</td>
              <td class="py-4 px-6">No (Non-edible peeling grade)</td>
            </tr>
            <tr class="border-b border-slate-100">
              <td class="py-4 px-6 bg-slate-50/70 font-bold text-slate-900">Caliber Range</td>
              <td class="py-4 px-6">40mm - 200mm</td>
              <td class="py-4 px-6">13mm - 50mm</td>
              <td class="py-4 px-6">14mm - 40mm (Flexible)</td>
            </tr>
            <tr class="border-b border-slate-100">
              <td class="py-4 px-6 bg-slate-50/70 font-bold text-slate-900">Printing Capability</td>
              <td class="py-4 px-6">Up to 8 Colors (High Resolution)</td>
              <td class="py-4 px-6">Limited (Single Color / Logotypes)</td>
              <td class="py-4 px-6">Not Recommended for Cellulose</td>
            </tr>
            <tr class="border-b border-slate-100">
              <td class="py-4 px-6 bg-slate-50/70 font-bold text-slate-900">Smoke Permeability</td>
              <td class="py-4 px-6">Optional (Smokable series only)</td>
              <td class="py-4 px-6">Excellent (Natural smoke absorption)</td>
              <td class="py-4 px-6">Outstanding (Designed for smoke houses)</td>
            </tr>
            <tr class="border-b border-slate-100">
              <td class="py-4 px-6 bg-slate-50/70 font-bold text-slate-900">Filling Machinery</td>
              <td class="py-4 px-6">Automatic Clipping Equipment (Poly-clip, Alpina, etc.)</td>
              <td class="py-4 px-6">High-Speed Linking & Twisting Lines</td>
              <td class="py-4 px-6">High-Speed Peeling Lines (Linker + Peeler)</td>
            </tr>
            <tr>
              <td class="py-4 px-6 bg-slate-50/70 font-bold text-slate-900">Typical Applications</td>
              <td class="py-4 px-6">Cooked Sausage, Bologna, Ham, Mortadella</td>
              <td class="py-4 px-6">Frankfurters, Hot Dogs, Snack Sticks</td>
              <td class="py-4 px-6">High-Speed Frankfurter Lines, Skinless Sausage</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="mt-8 max-w-7xl mx-auto">
        <a href="/downloads/technical-datasheet.pdf" class="inline-flex items-center gap-2 py-3.5 px-6 bg-slate-900 hover:bg-orange-500 text-white font-bold text-xs uppercase tracking-widest rounded transition-colors no-underline shadow-sm">
          <span>⬇️</span> Download Full Technical Datasheet & Splicing Guides (PDF)
        </a>
      </div>

    </div>
  </section>

  <section class="py-24 bg-white text-slate-900 scroll-mt-24 border-t border-b border-slate-100" id="technical-center">
    <div class="container mx-auto px-4">
      
