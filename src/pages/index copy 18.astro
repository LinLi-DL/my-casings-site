<script>
    // 直接从本地 node_modules 导入核心库
    import Swiper from "swiper";
    
    // 导入核心样式以及组件所需的功能样式
    import "swiper/css";
    import "swiper/css/pagination";
    import "swiper/css/effect-fade";
    
    // 必须显式导入并加载所需的核心功能模块
    import { Autoplay, Pagination, EffectFade } from "swiper/modules";

    // 封装初始化函数
    function initHeroSwiper() {
      const swiperContainer = document.querySelector(".hero-swiper");
      
      if (swiperContainer) {
        new Swiper(".hero-swiper", {
          // 注入核心驱动模块，使 fade 效果和自动播放生效
          modules: [Pagination, Autoplay, EffectFade],
          
          effect: "fade",
          fadeEffect: {
            crossFade: true // 开启平滑交叉淡化过渡
          },
          autoplay: { 
            delay: 4000, // 每 4 秒自动切换
            disableOnInteraction: false // 鼠标点击或拖拽后依然保持自动轮播
          },
          speed: 1000, // 切换转场动画持续 1 秒
          pagination: { 
            el: ".swiper-pagination", 
            clickable: true 
          },
          loop: true, // 开启无限循环滚动
        });
      }
    }

    // 针对传统常规 DOM 加载周期的安全挂载
    document.addEventListener("DOMContentLoaded", initHeroSwiper);

    // 针对开启了 Astro 视图过渡（View Transitions）或高级路由的兼容支持
    document.addEventListener("astro:page-load", initHeroSwiper);
    
    // 保底即时挂载机制
    if (document.readyState === "interactive" || document.readyState === "complete") {
      initHeroSwiper();
    }
  </script>

  <style is:global>
    @keyframes marquee {
      0% { transform: translateX(0%); }
      100% { transform: translateX(-50%); }
    }
    .animate-marquee {
      animation: marquee 20s linear infinite;
    }
    
    /* 确保淡入淡出动画过渡期间幻灯片不会出现诡异的内容闪烁或重叠 */
    .hero-swiper .swiper-slide {
      opacity: 0 !important;
      transition: opacity 1000ms ease-in-out;
    }
    .hero-swiper .swiper-slide-active {
      opacity: 1 !important;
    }
  </style>
