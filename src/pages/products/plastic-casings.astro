---
import Base from "@/layouts/Base.astro";
---

<Base title="Plastic Casing Category - HAITU CASING">

  <section class="relative w-full h-[65vh] md:h-[550px] bg-slate-900 overflow-hidden">
    <img 
      src="/images/plastic-casing-banner.png" 
      alt="Plastic Casing Banner" 
      class="absolute inset-0 w-full h-full object-fill opacity-60"
    />
    <div class="absolute inset-0 flex flex-col justify-center items-center text-center px-4">
      <h1 class="text-4xl md:text-6xl font-black tracking-wide text-orange-500 drop-shadow-[0_4px_12px_rgba(0,0,0,0.8)] uppercase my-0">
        Plastic Casing
      </h1>
      <p class="text-2xl md:text-3xl font-bold mt-4 tracking-wide text-white drop-shadow-[0_4px_8px_rgba(0,0,0,0.8)] uppercase my-0">
        High Barrier & Premium Solutions
      </p>
    </div>
  </section>

  <div class="w-full bg-[#1e293b] text-slate-400 py-3 border-b border-slate-800/60">
    <div class="container mx-auto px-4 flex justify-between items-center">
      <div class="text-white uppercase font-black tracking-wider text-base md:text-lg">
        <span class="text-orange-500">Plastic Casing Category</span>
      </div>
      <div class="text-[11px]">
        <a href="/collagen-casing" class="text-slate-300 hover:text-orange-500 no-underline font-semibold flex items-center gap-1">
          Switch to Collagen Casing &rarr;
        </a>
      </div>
    </div>
  </div>

  <!-- Quick Directory - 统一大小 -->
  <div class="w-full bg-white pt-12 pb-2">
    <div class="max-w-5xl mx-auto px-4">
      <div class="bg-slate-50 border border-slate-100 rounded-xl p-4 flex flex-wrap items-center justify-center gap-3 shadow-sm">
        <div class="text-[11px] font-bold text-slate-400 tracking-wider uppercase pl-2">
          🎯 Quick Directory:
        </div>
        <div class="flex flex-wrap gap-3 justify-center">
          <a href="#high-barrier" 
             class="min-w-[180px] text-center px-6 py-3 bg-white border border-slate-200 rounded-xl font-bold text-slate-700 hover:border-orange-500 hover:text-orange-500 transition shadow-sm">
            High Barrier
          </a>
          <a href="#smokable" 
             class="min-w-[180px] text-center px-6 py-3 bg-white border border-slate-200 rounded-xl font-bold text-slate-700 hover:border-orange-500 hover:text-orange-500 transition shadow-sm">
            Smokable Casing
          </a>
          <a href="#customized" 
             class="min-w-[180px] text-center px-6 py-3 bg-white border border-slate-200 rounded-xl font-bold text-slate-700 hover:border-orange-500 hover:text-orange-500 transition shadow-sm">
            Customized Solutions
          </a>
        </div>
      </div>
    </div>
  </div>

  <section class="pt-8 pb-24 bg-white">
    <div class="container mx-auto px-4">
      
      <div class="max-w-5xl mx-auto bg-slate-50 border border-slate-100 rounded-2xl p-6 space-y-8 shadow-sm">
        
        <!-- 1. High Barrier -->
        <div id="high-barrier" class="scroll-mt-40 bg-white rounded-2xl border border-slate-200/60 overflow-hidden shadow-sm pt-6">
          <div class="px-8 md:px-10">
            <span class="inline-block px-4 py-1.5 bg-orange-100 text-orange-600 text-xs font-bold tracking-widest rounded-full mb-4">
              HIGH BARRIER SERIES
            </span>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2">
            <div class="p-8 md:p-10 flex flex-col justify-between space-y-4">
              <div>
                <h3 class="text-2xl font-bold text-slate-800 mb-4 relative pb-2 after:absolute after:bottom-0 after:left-0 after:w-12 after:h-[2px] after:bg-orange-500">
                  High Barrier Vacuum Bagging Film
                </h3>
                <p class="text-xs text-slate-500 leading-relaxed text-justify">
                  Most food products require modified atmosphere or vacuum packaging, such as fresh meats, processed meats, cheeses, seafood and other perishable products.
                </p>
              </div>

              <div class="bg-slate-50 p-4 border border-slate-100 rounded-xl space-y-2 text-xs text-slate-600 font-medium">
                <div>• Multi-layer with EVOH high barrier</div>
                <div>• Oxygen transmission &lt; 1 cm³/m².d.bar</div>
                <div>• Excellent puncture & sealing performance</div>
              </div>
            </div>
            <div class="bg-slate-100/30 p-6 flex items-center justify-center border-l border-slate-100/80">
              <img src="/images/products/high-barrier.jpg" alt="High Barrier Film" class="w-full max-w-[280px] rounded shadow-sm" />
            </div>
          </div>
        </div>

        <!-- 2. Smokable -->
        <div id="smokable" class="scroll-mt-40 bg-white rounded-2xl border border-slate-200/60 overflow-hidden shadow-sm pt-6">
          <div class="px-8 md:px-10">
            <span class="inline-block px-4 py-1.5 bg-orange-100 text-orange-600 text-xs font-bold tracking-widest rounded-full mb-4">
              SMOKABLE SERIES
            </span>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2">
            <div class="bg-slate-100/30 p-6 flex items-center justify-center border-r border-slate-100/80 md:order-first order-last">
              <img src="/images/products/smokable-casing.jpg" alt="Smokable Plastic Casing" class="w-full max-w-[280px] rounded shadow-sm" />
            </div>
            <div class="p-8 md:p-10 flex flex-col justify-between space-y-4">
              <div>
                <h3 class="text-2xl font-bold text-slate-800 mb-4 relative pb-2 after:absolute after:bottom-0 after:left-0 after:w-12 after:h-[2px] after:bg-orange-500">
                  Smokable Plastic Casing
                </h3>
                <p class="text-xs text-slate-500 leading-relaxed text-justify">
                  Specially designed for smoked sausages with excellent smoke permeability, high strength and good shrinkage.
                </p>
              </div>
              <div class="bg-slate-50 p-4 border border-slate-100 rounded-xl space-y-2 text-xs text-slate-600 font-medium">
                <div>• High smoke permeability</div>
                <div>• Uniform caliber & shrinkage</div>
                <div>• Suitable for automatic filling</div>
              </div>
            </div>
          </div>
        </div>

        <!-- 3. Customized -->
        <div id="customized" class="scroll-mt-40 bg-white rounded-2xl border border-slate-200/60 overflow-hidden shadow-sm pt-6">
          <div class="px-8 md:px-10">
            <span class="inline-block px-4 py-1.5 bg-orange-100 text-orange-600 text-xs font-bold tracking-widest rounded-full mb-4">
              CUSTOMIZED SOLUTIONS
            </span>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2">
            <div class="p-8 md:p-10 flex flex-col justify-between space-y-4">
              <div>
                <h3 class="text-2xl font-bold text-slate-800 mb-4 relative pb-2 after:absolute after:bottom-0 after:left-0 after:w-12 after:h-[2px] after:bg-orange-500">
                  Customized Plastic Casing
                </h3>
                <p class="text-xs text-slate-500 leading-relaxed text-justify">
                  Tailor-made solutions according to your specific requirements on caliber, color, barrier properties, printing and shrinkage.
                </p>
              </div>
              <div class="bg-slate-50 p-4 border border-slate-100 rounded-xl space-y-2 text-xs text-slate-600 font-medium">
                <div>• Custom caliber & color</div>
                <div>• OEM / ODM supported</div>
                <div>• Special technical requirements available</div>
              </div>
            </div>
            <div class="bg-slate-100/30 p-6 flex items-center justify-center border-l border-slate-100/80">
              <img src="/images/products/customized.jpg" alt="Customized Plastic Casing" class="w-full max-w-[280px] rounded shadow-sm" />
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

</Base>