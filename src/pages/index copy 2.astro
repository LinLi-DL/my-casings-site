---
import Base from "@/layouts/Base.astro";
---

<Base title="High-Performance Artificial Casings Supplier | 肠衣国际">
  
  <!-- ==========================================
       板块 1：Hero Area (升级版：活力暖红遮罩 + 文字分批动效)
       ========================================== -->
  <section class="relative overflow-hidden hero-swiper-section bg-[#1a0505]">
    <!-- Swiper 主容器 -->
    <div class="swiper hero-swiper absolute inset-0 z-0">
      <div class="swiper-wrapper h-full w-full">
        
        <!-- 幻灯片 1：胶原肠衣主题 -->
        <div class="swiper-slide h-full w-full relative flex items-center">
          <img src="/images/hero/equipment.jpg" alt="Advanced Extrusion Lines" class="absolute inset-0 w-full h-full object-cover z-0" />
          <!-- 活力渐变遮罩：从极具质感和活力的肉制品深红（Burgundy Wine）渐变到通透，绝不沉闷 -->
          <div class="absolute inset-0 bg-gradient-to-r from-[#4a0e0e]/95 via-[#2d0505]/80 to-transparent z-10"></div>
          
          <!-- 幻灯片 1 独立内容 -->
          <div class="container relative z-20 text-left">
            <div class="max-w-3xl px-4 md:px-0">
              <span class="slide-element animate-fade-in inline-block bg-[#dc2626] text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-4">
                Premium Collagen Casings
              </span>
              <h1 class="slide-element animate-slide-up-1 font-primary font-black text-4xl md:text-6xl leading-tight mb-4 text-white">
                High-Performance<br/>Artificial Casings
              </h1>
              <p class="slide-element animate-slide-up-2 text-lg text-gray-200 mb-8 max-w-xl">
                Engineered for modern high-speed automatic sausage production lines. Exceptional caliber uniformity and superior mechanical strength.
              </p>
              <div class="slide-element animate-slide-up-3 flex flex-wrap gap-4">
                <a href="#contact" class="btn bg-[#dc2626] hover:bg-[#b91c1c] text-white font-bold text-base px-8 py-4 rounded shadow-lg transition">
                  Get Free Samples
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- 幻灯片 2：聚酰胺塑料肠衣主题 -->
        <div class="swiper-slide h-full w-full relative flex items-center">
          <img src="/images/hero/products-showcase.jpg" alt="Plastic Casings Range" class="absolute inset-0 w-full h-full object-cover z-0" />
          <!-- 采用相同色系的暖红渐变，保持全站视觉的一致性 -->
          <div class="absolute inset-0 bg-gradient-to-r from-[#4a0e0e]/95 via-[#2d0505]/80 to-transparent z-10"></div>
          
          <!-- 幻灯片 2 独立内容 -->
          <div class="container relative z-20 text-left">
            <div class="max-w-3xl px-4 md:px-0">
              <span class="slide-element animate-fade-in inline-block bg-[#e11d48] text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-4">
                Multi-Layer Polyamide Technology
              </span>
              <h2 class="slide-element animate-slide-up-1 font-primary font-black text-4xl md:text-6xl leading-tight mb-4 text-white">
                Zero Moisture Loss,<br/>Extended Shelf Life
              </h2>
              <p class="slide-element animate-slide-up-2 text-lg text-gray-200 mb-8 max-w-xl">
                Advanced nylon co-extrusion technology providing supreme oxygen and moisture barriers for cooked hams and salami.
              </p>
              <div class="slide-element animate-slide-up-3 flex flex-wrap gap-4">
                <a href="#specifications" class="btn border-2 border-white hover:bg-white hover:text-[#4a0e0e] text-white font-bold text-base px-8 py-4 rounded transition">
                  View Specifications
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- 幻灯片 3：工厂与全球供应链支持 -->
        <div class="swiper-slide h-full w-full relative flex items-center">
          <img src="/images/hero/exhibition.jpg" alt="Global Food Safety Standards" class="absolute inset-0 w-full h-full object-cover z-0" />
          <div class="absolute inset-0 bg-gradient-to-r from-[#4a0e0e]/95 via-[#2d0505]/80 to-transparent z-10"></div>
          
          <!-- 幻灯片 3 独立内容 -->
          <div class="container relative z-20 text-left">
            <div class="max-w-3xl px-4 md:px-0">
              <span class="slide-element animate-fade-in inline-block bg-[#ea580c] text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-4">
                Global Compliance & Quality
              </span>
              <h2 class="slide-element animate-slide-up-1 font-primary font-black text-4xl md:text-6xl leading-tight mb-4 text-white">
                ISO & HACCP Certified<br/>Industrial Supply
              </h2>
              <p class="slide-element animate-slide-up-2 text-lg text-gray-200 mb-8 max-w-xl">
                100% pre-shipment caliber tracking and laboratory testing. Securing steady lead times for meat processors worldwide.
              </p>
              <div class="slide-element animate-slide-up-3 flex flex-wrap gap-4">
                <a href="#contact" class="btn bg-[#dc2626] hover:bg-[#b91c1c] text-white font-bold text-base px-8 py-4 rounded shadow-lg transition">
                  Inquire Factory Price
                </a>
              </div>
            </div>
          </div>
        </div>

      </div>
      <!-- 轮播图小圆点 -->
      <div class="swiper-pagination hero-pagination !bottom-6 !z-30"></div>
    </div>
  </section>

  <!-- ==========================================
       后面的 Product Lines, Technical Grid 保持不变 
       ========================================== -->
  <section class="section bg-white" id="products">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-dark mb-4">Our Main Product Range</h2>
        <p class="text-text">We supply comprehensively structured artificial casing series to fulfill diverse meat processing requirements.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        <!-- 胶原肠衣卡片 -->
        <div class="bg-theme-light rounded-xl overflow-hidden shadow-sm hover:shadow-md transition flex flex-col justify-between border border-gray-100">
          <div>
            <div class="h-64 overflow-hidden">
              <img src="/images/products/collagen-casing.jpg" alt="Collagen Casings" class="w-full h-full object-cover" />
            </div>
            <div class="p-8">
              <h3 class="text-2xl font-bold text-dark mb-3">Collagen Casings Series</h3>
              <p class="text-text mb-4 text-sm leading-relaxed">
                Made from high-quality bovine collagen fibers. Designed as the perfect alternative to natural casings, providing uniform caliber control, a tender bite, and excellent smoke/moisture permeability.
              </p>
              <div class="space-y-1 text-xs text-text bg-white p-4 rounded border border-gray-200">
                <p><strong>• Available Caliber:</strong> 13mm - 32mm (Edible) / Up to 50mm (Non-Edible)</p>
                <p><strong>• Recommended For:</strong> Frankfurters, Hot Dogs, Breakfast Links, Smoked Sausages</p>
                <p><strong>• Advantages:</strong> High elasticity, structural stability on high-speed automatic twisters</p>
              </div>
            </div>
          </div>
          <div class="p-6 bg-gray-50 border-t border-gray-100 flex justify-between items-center">
            <span class="text-xs font-bold text-[#dc2626]">ISO & HALAL Compliant</span>
            <a href="/products" class="text-sm font-bold text-primary hover:underline">Product Catalog →</a>
          </div>
        </div>

        <!-- 塑料肠衣卡片 -->
        <div class="bg-theme-light rounded-xl overflow-hidden shadow-sm hover:shadow-md transition flex flex-col justify-between border border-gray-100">
          <div>
            <div class="h-64 overflow-hidden">
              <img src="/images/products/plastic-casing.jpg" alt="Plastic & Polyamide Casings" class="w-full h-full object-cover" />
            </div>
            <div class="p-8">
              <h3 class="text-2xl font-bold text-dark mb-3">Plastic & Polyamide Casings Series</h3>
              <p class="text-text mb-4 text-sm leading-relaxed">
                Manufactured using advanced multi-layer nylon co-extrusion technology. Features supreme oxygen and moisture barrier properties, minimizing weight loss and maximizing the product shelf-life.
              </p>
              <div class="space-y-1 text-xs text-text bg-white p-4 rounded border border-gray-200">
                <p><strong>• Available Flat Width:</strong> 30mm - 250mm</p>
                <p><strong>• Recommended For:</strong> Cooked Hams, Chub Sausages, Mortadella, Bologna Sausages</p>
                <p><strong>• Advantages:</strong> Multi-color surface printing available, zero moisture loss during boiling</p>
              </div>
            </div>
          </div>
          <div class="p-6 bg-gray-50 border-t border-gray-100 flex justify-between items-center">
            <span class="text-xs font-bold text-[#dc2626]">High Barrier & High Shrinkage</span>
            <a href="/products" class="text-sm font-bold text-primary hover:underline">Product Catalog →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 参数表格 -->
  <section class="section bg-theme-light border-t border-b border-gray-200" id="specifications">
    <div class="container max-w-4xl">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-dark mb-4">Technical Specifications Grid</h2>
        <p class="text-text">Quick reference data for factory procurement managers and technical directors.</p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-gray-200 shadow-sm bg-white">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-[#4a0e0e] text-white font-semibold">
              <th class="p-4">Casing Category</th>
              <th class="p-4">Caliber / Flat Width Range</th>
              <th class="p-4">Key Properties</th>
              <th class="p-4">Processing Type</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 text-text">
            <tr class="hover:bg-gray-50">
              <td class="p-4 font-bold text-dark">Edible Collagen Casing</td>
              <td class="p-4">13mm - 32mm</td>
              <td class="p-4">Excellent bite tenderness, consistent shrinkage</td>
              <td class="p-4">Smoking, Drying, Frying</td>
            </tr>
            <tr class="hover:bg-gray-50">
              <td class="p-4 font-bold text-dark">Non-Edible Collagen Casing</td>
              <td class="p-4">32mm - 50mm+</td>
              <td class="p-4">Reinforced mechanical filling resistance</td>
              <td class="p-4">Salami, Sliced Sausages</td>
            </tr>
            <tr class="hover:bg-gray-50">
              <td class="p-4 font-bold text-dark">Multi-Layer Polyamide (Plastic)</td>
              <td class="p-4">Flat Width: 30mm - 250mm</td>
              <td class="p-4">Oxygen barrier, tight clipping behavior</td>
              <td class="p-4">Water Boiling, Retort Steaming</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 表单区域 -->
  <section class="section bg-white" id="contact">
    <div class="container max-w-3xl">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-dark mb-4">Request Commercial Samples & Quotes</h2>
        <p class="text-text">Let our technical team know your operational stuffing speed and required specifications.</p>
      </div>
      <form class="space-y-6 border border-gray-100 p-8 rounded-xl shadow-sm bg-theme-light">
        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-semibold text-dark mb-2">Your Name</label>
            <input type="text" class="w-full border border-gray-200 bg-white rounded px-4 py-3 focus:outline-none focus:border-[#dc2626]" placeholder="Name" required />
          </div>
          <div>
            <label class="block text-sm font-semibold text-dark mb-2">Business Email</label>
            <input type="email" class="w-full border border-gray-200 bg-white rounded px-4 py-3 focus:outline-none focus:border-[#dc2626]" placeholder="email@company.com" required />
          </div>
        </div>
        <div>
          <label class="block text-sm font-semibold text-dark mb-2">Target Casing Material</label>
          <select class="w-full border border-gray-200 bg-white rounded px-4 py-3 focus:outline-none focus:border-[#dc2626]">
            <option>Collagen Casings (Edible)</option>
            <option>Collagen Casings (Non-Edible)</option>
            <option>Plastic / Polyamide Casings</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold text-dark mb-2">Detailed Requirements</label>
          <textarea rows="4" class="w-full border border-gray-200 bg-white rounded px-4 py-3 focus:outline-none focus:border-[#dc2626]" placeholder="Please tell us what sausage product you make..." required></textarea>
        </div>
        <button type="submit" class="w-full bg-[#dc2626] hover:bg-[#b91c1c] text-white font-bold py-4 rounded transition text-sm tracking-wider uppercase">
          Submit Sample Request
        </button>
      </form>
    </div>
  </section>

  <script>
    import Swiper from "swiper";
    import "swiper/css";
    import "swiper/css/pagination";
    import "swiper/css/effect-fade";
    import { Autoplay, Pagination, EffectFade } from "swiper/modules";

    document.addEventListener("astro:page-load", () => {
      if (document.querySelector(".hero-swiper")) {
        new Swiper(".hero-swiper", {
          modules: [Pagination, Autoplay, EffectFade],
          effect: "fade",
          fadeEffect: { crossFade: true },
          autoplay: {
            delay: 5500, // 稍微拉长停留时间，给买家时间看完动效字
            disableOnInteraction: false,
          },
          pagination: {
            el: ".hero-pagination",
            clickable: true,
          },
          loop: true,
        });
      }
    });
  </script>
</Base>